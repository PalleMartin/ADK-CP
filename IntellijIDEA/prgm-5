class Person(var name:String,var age:Int){ //PRIMARY CONSTRUCTOR
    /*var name:String="Alex" var age:Int=21*/
    var sal:Double=0.0
    constructor(name:String) : this (name,age=0){
    }
    constructor(name:String, age:Int, sal:Double):this(name,age){
        this.sal = sal
    }
    fun getPersonData():String{
        return "$name is $age years old and earns $sal"
    }
}
