fun main() {
    val n = 6
    var i = n
    while (i >= 1) {
        var spaces = 0
        while (spaces < n - i) {
            print(" ")
            spaces++
        }
        var stars = 0
        while (stars < i) {
            print("* ")
            stars++
        }
        println()
        i--
    }
}
